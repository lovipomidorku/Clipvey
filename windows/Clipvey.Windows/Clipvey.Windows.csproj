<Project Sdk="Microsoft.NET.Sdk">
  <!-- Приложение для Windows: значок в трее, панель устройств, синхронизация буфера обмена.
       Интерфейс — WPF с темой Windows 11 (ThemeMode), значок в трее — NotifyIcon из WinForms.
       Собирается на Mac: dotnet publish Clipvey.Windows -c Release → один Clipvey.exe без установки .NET. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Clipvey</AssemblyName>
    <RootNamespace>Clipvey.Windows</RootNamespace>
    <ApplicationIcon>Clipvey.ico</ApplicationIcon>
    <!-- DPI для каждого монитора (PerMonitorV2) и Common Controls 6 — в манифесте: их читают и WPF, и WinForms. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: ThemeMode (тема Windows 11) в WPF помечен как экспериментальный.
         WFO0003: WinForms советует задавать DPI не в манифесте, но цикл сообщений и окна здесь — WPF, ему нужен манифест. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <!-- Имена из WinForms и WPF совпадают (Application, Point, Color…): пространства имён подключаются в файлах явно. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF убирает их из неявных (конфликт с System.Windows.Shapes.Path), а коду вне интерфейса они нужны. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clipvey.Core\Clipvey.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.*" />
    <EmbeddedResource Include="Clipvey.ico" LogicalName="Clipvey.ico" />
  </ItemGroup>
</Project>
