<Window x:Class="Clipvey.Windows.PanelWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Clipvey"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="Transparent"
        FontFamily="{StaticResource TextFont}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!-- Всплывающая панель у значка в трее: без заголовка, рамку, тень и скруглённые углы рисует DWM,
         подложка — Acrylic (PanelWindow.xaml.cs). Содержимое не пересоздаётся: RefreshContent только
         обновляет тексты, видимость и списки, поэтому фокус и набранный текст не теряются. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
    <!-- Светлая подложка Acrylic у DWM прозрачнее, чем у панелей Windows 11: поверх неё — полупрозрачный фон темы. -->
    <Border x:Name="Tint" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.6"
            IsHitTestVisible="False" Visibility="Collapsed" />
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,14,16,12">
            <!-- Главная: устройства -->
            <StackPanel x:Name="MainPage">
                <!-- Заголовок главной страницы: значок, «Clipvey», шестерёнка -->
                <Grid Margin="2,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AppIconImage" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="Clipvey" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource SubtleButton}" Margin="0,0,-6,0"
                            AutomationProperties.AutomationId="open-settings" Click="OnOpenSettings">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Идёт связывание, а открыта главная: строка-переход в настройки -->
                <Button x:Name="PairingBar" Style="{StaticResource BarButton}" Margin="0,0,0,8"
                        AutomationProperties.AutomationId="pairing-continue" Click="OnOpenSettings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="PairingBarText" Grid.Column="1" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Margin="8,0,0,0" />
                    </Grid>
                </Button>

                <!-- Полоса «Доступна версия» -->
                <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Visibility="Collapsed"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="16" Margin="0,2,12,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="BannerTitle" Style="{StaticResource BodyStrong}" />
                            <TextBlock x:Name="BannerProgress" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <StackPanel x:Name="BannerButtons" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BannerInstall" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="update-install" Click="OnInstallUpdate" />
                                <Button x:Name="BannerLater" MinWidth="96" AutomationProperties.AutomationId="update-later" Click="OnDismissUpdate" />
                            </StackPanel>
                            <TextBlock x:Name="BannerNotice" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Устройства -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DevicesTitle" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DevicesNote" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,8,2,8" />
                </Grid>
                <Border x:Name="NoDevicesCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="NoDevicesText" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="NoDevicesSettings" HorizontalAlignment="Left" Margin="0,12,0,0"
                                AutomationProperties.AutomationId="empty-open-settings" Click="OnOpenSettings" />
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="DeviceList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,10,8,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Значок типа и точка состояния -->
                                        <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding TypeDescription}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="24" />
                                            <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFillColorDisabledBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RealName}" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Visibility="{Binding RealNameVisibility}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="Status" Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" Margin="12,0,4,0"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      AutomationProperties.AutomationId="{Binding ToggleId}"
                                                      AutomationProperties.Name="{Binding ToggleName}"
                                                      Click="OnDeviceToggle" />
                                        <Button Grid.Column="3" Style="{StaticResource SubtleButton}"
                                                AutomationProperties.AutomationId="{Binding MoreId}"
                                                AutomationProperties.Name="{Binding MoreName}"
                                                ToolTip="{Binding MoreName}"
                                                Click="OnDeviceMore">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" FontSize="16" />
                                        </Button>
                                    </Grid>

                                    <!-- Переименование прямо в карточке -->
                                    <StackPanel Visibility="{Binding RenameVisibility}" Margin="44,10,4,2">
                                        <TextBlock Text="{Binding AliasPrompt}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                        <TextBox x:Name="AliasBox" MaxLength="63" Text="{Binding AliasDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="{Binding AliasId}"
                                                 AutomationProperties.Name="{Binding AliasPrompt}"
                                                 KeyDown="OnAliasKeyDown" IsVisibleChanged="OnAliasVisibleChanged" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{Binding SaveText}" Style="{DynamicResource AccentButtonStyle}" MinWidth="80" Margin="0,0,8,0"
                                                    AutomationProperties.AutomationId="{Binding SaveId}" Click="OnAliasSave" />
                                            <Button Content="{Binding ResetText}" MinWidth="80" Margin="0,0,8,0" Visibility="{Binding ResetVisibility}"
                                                    AutomationProperties.AutomationId="{Binding ResetId}" Click="OnAliasReset" />
                                            <Button Content="{Binding CancelText}" MinWidth="80"
                                                    AutomationProperties.AutomationId="{Binding CancelId}" Click="OnAliasCancel" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Вопрос «Разорвать связь?» -->
                                    <StackPanel Visibility="{Binding UnpairVisibility}" Margin="44,10,4,2">
                                        <TextBlock Text="{Binding UnpairQuestion}" Style="{StaticResource Body}" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="{Binding UnpairText}" MinWidth="80" Margin="0,0,8,0"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    AutomationProperties.AutomationId="{Binding UnpairYesId}" Click="OnUnpairYes" />
                                            <Button Content="{Binding CancelText}" MinWidth="80"
                                                    AutomationProperties.AutomationId="{Binding UnpairNoId}" Click="OnUnpairNo" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Problem">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="LastSyncText" Style="{StaticResource Caption}" Margin="2,0,0,2" />

            </StackPanel>

            <!-- Настройки: связывание, этот компьютер, обновления -->
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                <!-- Заголовок страницы настроек: «‹» и «Настройки» -->
                <Grid Margin="-6,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="back" Click="OnBack">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="SettingsPageTitle" Grid.Column="1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>

                <!-- Связывание -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PairingTitle" Style="{StaticResource SectionTitle}" Margin="2,4,0,8" />
                    <TextBlock x:Name="Countdown" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,4,2,8"
                               AutomationProperties.AutomationId="countdown" />
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Нет связывания -->
                        <StackPanel x:Name="PairIdle">
                            <Button x:Name="PairStart" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="pairing-start" Click="OnPairingStart" />
                        </StackPanel>

                        <!-- Режим связывания: кандидаты -->
                        <StackPanel x:Name="PairMode">
                            <TextBlock x:Name="PairModeText" Style="{StaticResource Body}" />
                            <StackPanel x:Name="Searching" Margin="0,12,0,2">
                                <TextBlock x:Name="SearchingText" Style="{StaticResource Caption}" />
                                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" />
                            </StackPanel>
                            <ItemsControl x:Name="CandidateList" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="20" Width="32" Margin="0,0,10,0"
                                                       AutomationProperties.Name="{Binding TypeDescription}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Content="{Binding PairText}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0"
                                                    AutomationProperties.AutomationId="{Binding PairId}" Click="OnCandidatePair" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="PairClose" HorizontalAlignment="Left" Margin="0,10,0,0" MinWidth="80"
                                    AutomationProperties.AutomationId="pairing-close" Click="OnPairingClose" />
                        </StackPanel>

                        <!-- Роль R: этот компьютер показывает код -->
                        <StackPanel x:Name="PairIncoming">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="IncomingGlyph" Style="{StaticResource Glyph}" FontSize="20" Width="32" Margin="0,0,10,0" />
                                <TextBlock x:Name="IncomingTitle" Grid.Column="1" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="IncomingCode" FontFamily="{StaticResource CodeFont}" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,10,0,6"
                                       AutomationProperties.AutomationId="pair-code" />
                            <TextBlock x:Name="IncomingText" Style="{StaticResource Body}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="IncomingDone" Style="{DynamicResource AccentButtonStyle}" MinWidth="80" Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="pair-done" Click="OnIncomingDone" />
                                <Button x:Name="IncomingCancel" MinWidth="80" AutomationProperties.AutomationId="pair-cancel" Click="OnIncomingCancel" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Роль I: этот компьютер вводит код -->
                        <StackPanel x:Name="PairOutgoing">
                            <TextBlock x:Name="OutgoingTitle" Style="{StaticResource BodyStrong}" />
                            <TextBlock x:Name="OutgoingText" Style="{StaticResource Body}" Margin="0,6,0,0" />
                            <StackPanel x:Name="CodeEntry" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="CodeBox" Width="140" MaxLength="6" FontFamily="{StaticResource CodeFont}" FontSize="22"
                                         HorizontalContentAlignment="Center" InputScope="Number"
                                         AutomationProperties.AutomationId="code"
                                         PreviewTextInput="OnCodePreviewTextInput" KeyDown="OnCodeKeyDown" TextChanged="OnCodeChanged" />
                                <Button x:Name="CodeSubmit" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                        AutomationProperties.AutomationId="code-submit" Click="OnCodeSubmit" />
                            </StackPanel>
                            <Button x:Name="OutgoingCancel" HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="80"
                                    AutomationProperties.AutomationId="outgoing-cancel" Click="OnOutgoingCancel" />
                        </StackPanel>

                        <TextBlock x:Name="PairResult" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   AutomationProperties.AutomationId="pair-result" />
                    </StackPanel>
                </Border>

                <!-- Настройки -->
                <TextBlock x:Name="GeneralTitle" Style="{StaticResource SectionTitle}" Margin="2,14,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="NameTitle" Style="{StaticResource Body}" Margin="0,0,0,6" />
                        <TextBox x:Name="NameBox" MaxLength="63" AutomationProperties.AutomationId="self-name"
                                 TextChanged="OnNameChanged" KeyDown="OnNameKeyDown" LostKeyboardFocus="OnNameLostFocus" />
                        <TextBlock x:Name="NameHint" Style="{StaticResource Caption}" Margin="0,6,0,0" />

                        <Separator Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ImagesText" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="ImagesSwitch" Grid.Column="1" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                          AutomationProperties.AutomationId="images" Click="OnImagesClick" />
                        </Grid>


                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutostartText" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="AutostartSwitch" Grid.Column="1" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                          AutomationProperties.AutomationId="autostart" Click="OnAutostartClick" />
                        </Grid>


                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageText" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="150" Margin="12,0,0,0"
                                      AutomationProperties.AutomationId="language" SelectionChanged="OnLanguageSelected" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Обновления -->
                <TextBlock x:Name="UpdatesTitle" Style="{StaticResource SectionTitle}" Margin="2,14,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutoUpdateText" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="AutoUpdateSwitch" Grid.Column="1" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                          AutomationProperties.AutomationId="update-auto" Click="OnAutoUpdateClick" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                            <Button x:Name="CheckButton" Grid.Column="1" Margin="12,0,0,0" MinWidth="120"
                                    AutomationProperties.AutomationId="update-check" Click="OnCheckUpdates" />
                        </Grid>
                        <StackPanel x:Name="UpdateAvailable" Margin="0,12,0,0">
                            <Button x:Name="SettingsInstall" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="update-install-settings" Click="OnInstallUpdate" />
                            <TextBlock x:Name="SettingsProgress" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateNoticeText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Footer" Style="{StaticResource Caption}" Margin="2,4,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>
