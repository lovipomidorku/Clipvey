<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Проверка уязвимостей пакетов ходит в сеть и у нас упирается в таймаут; внешних пакетов нет. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
