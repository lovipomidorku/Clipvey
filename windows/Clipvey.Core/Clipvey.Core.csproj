<Project Sdk="Microsoft.NET.Sdk">
  <!-- Протокол, криптография и поиск Mac. Без зависимостей от Windows: проверяется на Mac через Clipvey.Peer. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clipvey.Tests" />
    <!-- Флаг двойника ignore-image-limit: проверка отказа у получателя картинки больше 20 МиБ. -->
    <InternalsVisibleTo Include="clipvey-peer" />
  </ItemGroup>
</Project>
